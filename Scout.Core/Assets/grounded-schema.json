{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "statements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "statement": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "contradicted",
                    "insufficient_evidence"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "block": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 12,
                        "maxLength": 180
                      }
                    },
                    "required": [
                      "block",
                      "quote"
                    ]
                  }
                }
              },
              "required": [
                "statement",
                "verdict",
                "evidence"
              ]
            }
          },
          "content_type": {
            "type": "string",
            "enum": [
              "complete_episode",
              "incomplete_episode",
              "preview_or_promo",
              "recap",
              "unknown"
            ]
          },
          "story_blocks": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": [
          "candidate",
          "statements",
          "content_type",
          "story_blocks",
          "reason"
        ]
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "single_episode",
            "continuous_parts",
            "separate_episodes",
            "incomplete_episode",
            "unresolved"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 240
        }
      },
      "required": [
        "kind",
        "candidates",
        "reason"
      ]
    }
  },
  "required": [
    "candidates",
    "recording"
  ]
}

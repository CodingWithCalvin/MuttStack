<Window x:Class="Tucker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tucker" Icon="Assets/Tucker.ico" Width="1440" Height="920" MinWidth="1080" MinHeight="740" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" Foreground="#F6F4F1">

<WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>

<Grid Background="{StaticResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

<DockPanel Background="#211A13"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Click="MinimizeWindow" Width="46" Padding="0" AutomationProperties.Name="Minimize"/><Button Content="□" Click="ToggleMaximize" Width="46" Padding="0" AutomationProperties.Name="Maximize or restore"/><Button Content="×" Click="CloseWindow" Width="46" Padding="0" AutomationProperties.Name="Close"/></StackPanel><StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center"><Image Source="Assets/Tucker.png" Width="20" Height="20"/><TextBlock Text="TUCKER" Foreground="#B9A28B" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>

<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<Border Background="#19140F" BorderBrush="#493B2D" BorderThickness="0,0,1,0" Padding="14,26,14,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Image Source="Assets/Tucker.png" Width="96" Height="96" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Tucker dog mascot"/>

<Button x:Name="NewTuckerButton" Content="+ New Tucker" Click="NewTucker" Style="{StaticResource Primary}" Margin="0,0,0,14" ToolTip="Combine existing rips and inbox batches in one saved run"/>

<Button x:Name="NavInbox" Tag="Inbox" Click="Navigate" Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Inbox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource LineIcon}" Data="{StaticResource FolderIcon}" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Inbox" VerticalAlignment="Center"/><Border Grid.Column="2" x:Name="InboxBadge" Visibility="Collapsed" Background="{StaticResource AccentBrush}" CornerRadius="10" MinWidth="22" Padding="6,2" Margin="8,0,0,0"><TextBlock x:Name="InboxCount" Foreground="#291E13" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border></Grid></Button>

<DockPanel Margin="14,20,0,10"><Button x:Name="ShowArchivedHistory" Content="Archived (0)" Click="ToggleArchiveHistory" DockPanel.Dock="Right" Padding="6,4" Margin="8,0,0,0" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="HistoryHeading" Text="TUCKER HISTORY" Foreground="#B9A28B" FontSize="10" VerticalAlignment="Center"/></DockPanel></StackPanel>

<ListBox Grid.Row="1" x:Name="QueueList" SelectionChanged="QueueSelected" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><EventSetter Event="PreviewMouseRightButtonDown" Handler="HistoryRightClick"/><EventSetter Event="ContextMenuOpening" Handler="HistoryMenuOpening"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding ArchiveAction}" IsEnabled="{Binding CanManage}"/><MenuItem Header="Delete" IsEnabled="{Binding CanManage}"/></ContextMenu></Setter.Value></Setter><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="Transparent" CornerRadius="4" Padding="4" BorderThickness="2,0,0,0" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#30251B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#46301E"/><Setter TargetName="Tile" Property="BorderBrush" Value="#E5AC69"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>

<StackPanel Grid.Row="2"><Border BorderBrush="#493B2D" BorderThickness="0,1,0,0" Margin="0,14"/><Button x:Name="NavActivity" Tag="Activity" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource ActivityIcon}" Margin="0,0,12,0"/><TextBlock Text="Activity"/></StackPanel></Button><Button x:Name="NavSettings" Tag="Settings" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource SettingsIcon}" Margin="0,0,12,0"/><TextBlock Text="Output &amp; settings"/></StackPanel></Button><TextBlock Text="0.1.0 · Doggo collection" Foreground="#B9A28B" FontSize="10" Margin="14,8,0,0"/></StackPanel>

</Grid></Border>

<Grid Grid.Column="1" Margin="24,16,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<StackPanel Margin="0,0,0,20"><TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Give your rips a smaller footprint. Keep every original." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>

<Grid Grid.Row="1" x:Name="QueuePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold"/><ProgressBar x:Name="RunProgress" Height="5" Margin="0,10"/><TextBlock x:Name="QueueState" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="StartSelected" Content="Start this Tucker" Click="StartQueues" Style="{StaticResource Primary}"/><Button x:Name="AddMoreButton" Content="Add more sources…" Click="AddMoreSources"/><Button x:Name="RestoreRunButton" Content="Restore Tucker" Click="RestoreSelected" Visibility="Collapsed"/></WrapPanel>
<DataGrid Grid.Row="2" x:Name="QueueGrid" SelectionChanged="Details"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Disc" Binding="{Binding DiscLabel}" Width="190"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/></DataGrid.Columns></DataGrid>
<TextBox Grid.Row="3" x:Name="Paths" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Text="Select a file to see its input, output and saved encoding settings."/>
</Grid>

<Grid Grid.Row="1" x:Name="NewTuckerPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><DockPanel><Button x:Name="ToggleSourcesButton" Content="Hide sources" Click="ToggleSources" DockPanel.Dock="Right" Padding="10,5" Margin="12,0,0,0"/><TextBlock x:Name="SourceSummary" Text="Sources · add folders and inbox batches" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel><StackPanel x:Name="SourceInputs" Margin="0,10,0,0"><WrapPanel x:Name="SourceControls" Margin="0,0,0,10"><Button x:Name="AddFoldersButton" Content="Add existing rips…" Click="AddFolders" Style="{StaticResource Primary}"/><Button x:Name="AddInboxButton" Content="Add inbox batches…" Tag="Inbox" Click="Navigate"/><Button x:Name="RemoveSourcesButton" Content="Remove selected" Click="RemoveSources"/><CheckBox x:Name="Recursive" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
<ListBox Height="90" x:Name="SourcesList" Visibility="Collapsed" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" Margin="4,3"/></DataTemplate></ListBox.ItemTemplate></ListBox>
</StackPanel></StackPanel>
<StackPanel Grid.Row="1" Margin="0,10"><WrapPanel><Button x:Name="PreviewButton" Content="Preview combined run" Click="Preview"/><Button Content="Output &amp; preset" Tag="Settings" Click="Navigate"/></WrapPanel><TextBlock x:Name="PreviewSummary" Text="Add folders and inbox batches in any combination. Originals stay where they are." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
<DataGrid Grid.Row="2" x:Name="PreviewGrid" SelectionChanged="PreviewDetails"><DataGrid.Columns><DataGridTextColumn Header="Output filename" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Disc" Binding="{Binding DiscLabel}" Width="190"/><DataGridTextColumn Header="Import" Binding="{Binding Status}" Width="125"/></DataGrid.Columns></DataGrid>
<TextBox Grid.Row="3" x:Name="PreviewPaths" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/>
<WrapPanel Grid.Row="4"><Button x:Name="AddWaiting" Content="Create Tucker" Click="AddPreview" Style="{StaticResource Primary}"/><Button x:Name="AddRunning" Content="Create &amp; add to active processing" Click="AddPreview"/><Button x:Name="CancelAdditions" Content="Cancel additions" Click="CancelAppend" Visibility="Collapsed"/></WrapPanel>
</Grid>

<Grid Grid.Row="1" x:Name="InboxPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Select one or more waiting batches to combine with existing rips in New Tucker. Batches are accepted only when the run is created." TextWrapping="Wrap" Style="{StaticResource Subtitle}"/><TextBlock Grid.Row="1" x:Name="InboxSummary" Margin="0,0,0,16"/><DataGrid Grid.Row="2" x:Name="InboxGrid" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Batch" Binding="{Binding Summary}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="ImportHandoff" Content="Import handoff…" Click="ImportManifest"/><Button x:Name="UseInboxBatches" Content="Add selected to New Tucker" Click="ReviewHandoff" Style="{StaticResource Primary}"/><Button Content="Decline selected" Click="DeclineHandoff"/><Button Content="Export acceptance receipt…" Click="ExportReceipt"/></WrapPanel></Grid>

<Grid Grid.Row="1" x:Name="ActivityPage" Visibility="Collapsed"><TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="12"/></Grid>

<Grid Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,16">

<TextBlock Text="Output &amp; naming" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

<TextBlock Text="Compressed output base folder" Margin="0,10,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOutput" Tag="Destination" Margin="8,0,0,0"/><TextBox x:Name="Destination" TextWrapping="Wrap"/></DockPanel>

<TextBlock Text="Relative folder format" Margin="0,10,0,6"/><DockPanel><TextBox x:Name="OutputFormat" TextWrapping="Wrap"/></DockPanel>

<Border x:Name="FolderExampleCard" Background="{StaticResource PanelBrush}" BorderBrush="#584A3B" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,12,0,4"><StackPanel>
<TextBlock Text="Folder preview" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
<ComboBox x:Name="FolderExampleSource" DisplayMemberPath="Display" SelectionChanged="FolderExampleChanged" AutomationProperties.Name="Folder preview source" Margin="0,8,0,8"/>
<TextBox x:Name="FolderExamplePath" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="13" AutomationProperties.Name="Resolved output folder"/>
<TextBlock x:Name="FolderExampleError" TextWrapping="Wrap" Foreground="#F0BC86" Visibility="Collapsed"/>
<TextBlock x:Name="FolderExampleMetadata" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
<TextBlock x:Name="FolderExampleNote" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
</StackPanel></Border>

<TextBlock Text="Filename format · {filename} keeps the original stem" Margin="0,10,0,6"/><TextBox x:Name="FilenameFormat" Text="{}{filename}"/><TextBlock Text="Filename prefix · original filename is retained" Margin="0,10,0,6"/><DockPanel><TextBox x:Name="Prefix" TextWrapping="Wrap"/></DockPanel>

<TextBlock Text="Tokens: {series}, {series_name}, {year}, {tvdb_id}, {season:00}, {volume_number}, {disc_number}, {disc_label}, {date}. Use {{ and }} for literal braces. Existing Ripley prefixes are retained." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/><TextBlock Text="HandBrake preset &amp; decoding" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="HandBrakeCLI executable" Margin="0,10,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFile" Tag="Cli" Margin="8,0,0,0"/><TextBox x:Name="Cli" TextWrapping="Wrap"/></DockPanel>

<TextBlock Text="Installed GUI presets or exported preset JSON" Margin="0,10,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFile" Tag="PresetFile" Margin="8,0,0,0"/><TextBox x:Name="PresetFile" TextWrapping="Wrap"/></DockPanel>

<TextBlock Text="HandBrake GUI settings · decoder preferences" Margin="0,10,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFile" Tag="GuiSettings" Margin="8,0,0,0"/><TextBox x:Name="GuiSettings" TextWrapping="Wrap"/></DockPanel>

<Button Content="Reload presets" Click="LoadPresets" HorizontalAlignment="Left" Margin="0,12"/><ComboBox x:Name="PresetChoice" DisplayMemberPath="Display" SelectionChanged="PresetChanged"/><TextBlock x:Name="PresetSummary" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Hardware decoding · does not change the video encoder" Margin="0,16,0,4"/><ComboBox x:Name="Hardware"><ComboBoxItem Content="Follow HandBrake GUI settings"/><ComboBoxItem Content="Software decoding"/><ComboBoxItem Content="NVIDIA NVDEC decoding"/><ComboBoxItem Content="Intel QSV decoding"/></ComboBox><Button Content="Check preset &amp; runtime" Click="CheckRuntime" HorizontalAlignment="Left"/><TextBlock Text="Doggo database" Margin="0,28,0,6"/><TextBox x:Name="StoragePath" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel></ScrollViewer><Button Grid.Row="1" Content="Save preferences" Click="SaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/></Grid><Border Grid.Row="2" x:Name="ActivityFooter" Background="{StaticResource PanelBrush}" BorderBrush="#493B2D" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,12,0,0"><StackPanel>
<DockPanel><WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0"><Button x:Name="StartAll" Content="Start all" Click="StartQueues" Padding="12,7"/><Button x:Name="PauseButton" Content="Pause after current file" Click="Pause" Padding="12,7"/><Button x:Name="StopButton" Content="Stop now…" Click="Stop" Padding="12,7" Margin="0"/></WrapPanel><TextBlock x:Name="OverallSummary" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/></DockPanel>
<ProgressBar x:Name="OverallProgress" Height="4" Margin="0,8,0,0" ToolTip="Completed files across all saved Tucker runs"/>
<StackPanel x:Name="ActiveEncoding" Margin="0,8,0,0"><TextBlock x:Name="CurrentFile" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="12"/><ProgressBar x:Name="Progress" Height="4" Margin="0,6"/><TextBlock x:Name="Speed" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
<TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
</StackPanel></Border></Grid></Grid></Grid></Window>

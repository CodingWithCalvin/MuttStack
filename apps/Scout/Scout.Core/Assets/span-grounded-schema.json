{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "statements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "statement": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "contradicted",
                    "insufficient_evidence"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "enum": [
                      "s0"
                    ]
                  }
                }
              },
              "required": [
                "statement",
                "verdict",
                "evidence"
              ]
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "main_story",
              "preview_or_promo",
              "recap",
              "unknown"
            ]
          }
        },
        "required": [
          "candidate",
          "statements",
          "role"
        ]
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "single_episode",
            "continuous_parts",
            "separate_episodes",
            "incomplete_episode",
            "unresolved"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "kind",
        "candidates"
      ]
    }
  },
  "required": [
    "candidates",
    "recording"
  ]
}
